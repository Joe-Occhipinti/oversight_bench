; Added after the base policy when commands have network access.
; Adapted from OpenAI Codex, codex-rs/sandboxing/src/seatbelt_network_policy.sbpl
; (Apache-2.0, Copyright 2025 OpenAI).

(allow system-socket
  (require-all
    (socket-domain AF_SYSTEM)
    (socket-protocol 2)))

(allow mach-lookup
  ; user directory locations
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.system.opendirectoryd.membership")
  ; TLS certificate checks
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.networkd")
  (global-name "com.apple.ocspd")
  (global-name "com.apple.trustd.agent")
  ; network configuration
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd"))

(allow sysctl-read (sysctl-name-regex #"^net.routetable"))
