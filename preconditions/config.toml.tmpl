model = "${agent_model}"
approvals_reviewer = "monitor"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
max_turn_steps = ${max_turn_steps}
notify = ["python3", "/app/tools/turn_complete_notify.py"]

[model_provider]
base_url = "http://gateway:4000/v1"

[monitor]
model = "${monitor_model}"

[[hooks.PostToolUse]]
matcher = "apply_patch"
command = ["python3", "tools/sync_code_graph.py"]
cwd = "."

[projects."/app"]
trust_level = "trusted"
